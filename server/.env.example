PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/webcuoi
# Use * for local development; set explicit frontend origins in production.
CORS_ORIGINS=*
ADMIN_API_KEY=replace-with-a-long-random-secret

# SMTP settings for RSVP notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=WebCuoi <your-email@example.com>
RSVP_NOTIFICATION_EMAIL=your-email@example.com
# Optional second recipient; RSVP notifications are delivered to both addresses.
RSVP_NOTIFICATION_EMAIL_2=

# Optional Maps Embed API key for an interactive map iframe URL.
GOOGLE_MAPS_EMBED_API_KEY=
